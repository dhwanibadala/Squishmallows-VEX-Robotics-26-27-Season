{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\n\n\n# wait for rotation sensor to fully initialize\nwait(30, MSEC)\n\n\n# Make random actually random\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()\n    urandom.seed(int(random))\n      \n# Set random seed \ninitializeRandomSeed()\n\n\ndef play_vexcode_sound(sound_name):\n    # Helper to make playing sounds from the V5 in VEXcode easier and\n    # keeps the code cleaner by making it clear what is happening.\n    print(\"VEXPlaySound:\" + sound_name)\n    wait(5, MSEC)\n\n# add a small delay to make sure we don't print in the middle of the REPL header\nwait(200, MSEC)\n# clear the console to make sure we don't have the REPL in the console\nprint(\"\\033[2J\")\n\n#endregion VEXcode Generated Robot Configuration\n#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\nmotor_1 = Motor(Ports.PORT1, GearSetting.RATIO_18_1, False)\nmotor_2 = Motor(Ports.PORT2, GearSetting.RATIO_18_1, False)\nmotor_3 = Motor(Ports.PORT3, GearSetting.RATIO_18_1, False)\nmotor_8 = Motor(Ports.PORT8, GearSetting.RATIO_18_1, False)\nmotor_9 = Motor(Ports.PORT9, GearSetting.RATIO_18_1, False)\nmotor_10 = Motor(Ports.PORT10, GearSetting.RATIO_18_1, False)\ninertial5 = Inertial(Ports.PORT5)\n#motor_10.set_reversed(True)\n\n\n# wait for rotation sensor to fully initialize\nwait(30, MSEC)\n\n\nmyVariable = 0\n\ncontroller = Controller()\n\nleft_front = Motor(Ports.PORT10, GearSetting.RATIO_18_1, False)\n#left_middle = Motor(Ports.PORT9, GearSetting.RATIO_18_1, False)\nleft_back = Motor(Ports.PORT8, GearSetting.RATIO_18_1, False)\nright_front = Motor(Ports.PORT1, GearSetting.RATIO_18_1, False)\n#right_middle = Motor(Ports.PORT2, GearSetting.RATIO_18_1, False)\nright_back = Motor(Ports.PORT3, GearSetting.RATIO_18_1, False)\n\nmotor_10 = MotorGroup(left_front, left_back)\nmotor_1 = MotorGroup(right_front, right_back)\n\ndef when_started1():\n    global myVariable\n    pass\n\ndef onauton_autonomous_0():\n    global myVariable\n    pass\n\ndef ondriver_drivercontrol_0():\n    global myVariable\n    while True:\n        wait(5, MSEC)\n\ndef vexcode_auton_function():\n    def calibrate_inertial():\n        inertial5.calibrate()\n        while inertial5.is_calibrating():\n            brain.screen.clear_screen()\n            brain.screen.print(\"Calibrating...\")\n            wait(50, MSEC)\n        brain.screen.clear_screen()\n        brain.screen.print(\"Calibration Done!\")\n    calibrate_inertial()\n\n    wheel_diameter_in = 3.25\n    wheel_circumference_in = 3.14156 * wheel_diameter_in\n\n    def drive_inches(inches, speed, forward=True, timeout=10) :\n        deg = ((inches / wheel_circumference_in) * 360) * 1.666667\n        direction = FORWARD if forward else REVERSE\n    \n        brain.screen.clear_screen()\n        brain.screen.print(\"Driving:\")\n        brain.screen.new_line()\n        brain.screen.print(inches)\n\n        motor_10.spin_for(direction, deg, DEGREES, speed, PERCENT, False)\n        motor_1.spin_for(direction, deg, DEGREES, speed, PERCENT)\n   \n    def turn_degrees(deg, speed):\n        motor_10.spin_for(FORWARD, deg, DEGREES, speed, PERCENT, False)\n        motor_1.spin_for(REVERSE, deg, DEGREES, speed, PERCENT)\n    \n    def turn_to(target_angle) :\n        if target_angle > 0: \n            motor_1.spin(REVERSE, 20, PERCENT)\n            motor_10.spin(REVERSE, 20, PERCENT) \n            while inertial5.rotation(DEGREES) < target_angle:\n                brain.screen.set_cursor(1,1)\n                brain.screen.print(\"Current: \")\n                brain.screen.print(inertial5.rotation(DEGREES))\n                wait(20, MSEC)\n        else: \n            motor_1.spin(FORWARD, 20, PERCENT) \n            motor_10.spin(FORWARD, 20, PERCENT)  \n            while inertial5.rotation(DEGREES) > target_angle:\n                brain.screen.set_cursor(1,1)\n                brain.screen.print(\"Current: \")\n                brain.screen.print(inertial5.rotation(DEGREES))\n                wait(20, MSEC)\n\n        motor_1.stop()\n        motor_10.stop()\n\n    DRIVE_SPEED = 18\n    TURN_SPEED = 32\n    #drive_inches(5, DRIVE_SPEED, forward=True)\n    turn_to(90)\n    \ndef vexcode_driver_function():\n    #brain.screen.print(\"Hello Ms. Wheaton\")\n   # motor_3.spin(FORWARD, 8, PERCENT)\n    #motor_3.spin(REVERSE, 8, PERCENT)\n\n    # Start the driver control tasks\n    driver_control_task_0 = Thread( ondriver_drivercontrol_0 )\n\n    # wait for the driver control period to end\n    while True:\n        forward = controller.axis1.position()\n        turn = controller.axis3.position()\n        left_speed = forward + turn\n        right_speed = forward - turn\n\n        motor_1.spin(FORWARD, left_speed, PERCENT)\n        motor_10.spin(FORWARD, right_speed, PERCENT)\n        wait(10, MSEC)\n        # wait 10 milliseconds before checking again\n        #wait( 10, MSEC )\n       # if controller.buttonR1.pressing():\n          #  motor_3.spin(FORWARD, 8, PERCENT)\n       # elif controller.buttonR2.pressing():\n         #   motor_3.spin(REVERSE, 8, PERCENT)\n    # Stop the driver control tasks\n    driver_control_task_0.stop()\n\n\n# register the competition functions\n#competition = Competition(vexcode_driver_function, vexcode_auton_function)\n\n#vexcode_auton_function()\nvexcode_driver_function()\n\n","textLanguage":"python","robotConfig":[],"slot":0,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.68.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}