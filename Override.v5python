{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\nmotor_6 = Motor(Ports.PORT6, GearSetting.RATIO_18_1, False)\nmotor_8 = Motor(Ports.PORT8, GearSetting.RATIO_18_1, False)\ninertial_ = Inertial(Ports.PORT19)\nmatchloader_a = DigitalOut(brain.three_wire_port.a)\ndescorer_b = DigitalOut(brain.three_wire_port.b)\nclaw_a = DigitalOut(brain.three_wire_port.c)\nmotor_2 = Motor(Ports.PORT2, GearSetting.RATIO_18_1, False)\nmotor_7 = Motor(Ports.PORT7, GearSetting.RATIO_18_1, False)\nmotor_18 = Motor(Ports.PORT18, GearSetting.RATIO_18_1, False)\n\n\n# wait for rotation sensor to fully initialize\nwait(30, MSEC)\n\n\n# Make random actually random\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()\n    urandom.seed(int(random))\n      \n# Set random seed \ninitializeRandomSeed()\n\n\ndef play_vexcode_sound(sound_name):\n    # Helper to make playing sounds from the V5 in VEXcode easier and\n    # keeps the code cleaner by making it clear what is happening.\n    print(\"VEXPlaySound:\" + sound_name)\n    wait(5, MSEC)\n\n# add a small delay to make sure we don't print in the middle of the REPL header\nwait(200, MSEC)\n# clear the console to make sure we don't have the REPL in the console\nprint(\"\\033[2J\")\n\n#endregion VEXcode Generated Robot Configuration\n\n# ---------------------------------------------------------\n# VEXcode V5 Python Competition Template – 6-Motor Drive\n# ---------------------------------------------------------\nfrom vex import *\n\nbrain = Brain()\ncontroller = Controller()\n\nL2_pressed_time = 0\nnow = 0\nintake_state = 0\ndescorer_b_state = False\nb_pressed_last = False\n\n# pneumatic states\nmatchloader_state = False\ndescorer_state = False\n\n\"\"\"\nPneumatics-Claw\n\"\"\"\nclaw_state = False\na_last = False\n\n# for detecting press edges\nx_last = False\nb_last = False\n\n# ---------------------------------------------------------\n# Motor setup (your ports)\nleft_front = Motor(Ports.PORT9, GearSetting.RATIO_18_1, False)\nleft_middle = Motor(Ports.PORT20, GearSetting.RATIO_18_1, False)\nleft_back = Motor(Ports.PORT1, GearSetting.RATIO_18_1, False)\n\nright_front = Motor(Ports.PORT10, GearSetting.RATIO_18_1, True)\nright_middle = Motor(Ports.PORT3, GearSetting.RATIO_18_1, True)\nright_back = Motor(Ports.PORT2, GearSetting.RATIO_18_1, True)\n\nleft_drive = MotorGroup(left_front, left_middle, left_back)\nright_drive = MotorGroup(right_front, right_middle, right_back)\n\n# ---------------------------------------------------------\n# Drive tuning\n# ---------------------------------------------------------\nMAX_DRIVE_SPEED = 100   # full speed when going straight\nTURN_SCALE = 0.6        # turn speed is 60% of drive speed\n\n## \ninertial19 = Inertial(Ports.PORT19)\nwait(10, MSEC)\n\ndef vexcode_auton_function():\n    # initial pneumatic positions - both retracted\n    matchloader_a.set(False)\n    descorer_b.set(False)\n\n    brain.screen.clear_screen()\n    brain.screen.print(\"Autonomous running...\")\n\n    # ----------------------------\n    # CONSTANTS\n    # ----------------------------\n    wheel_diameter_in = 3.25\n    wheel_diameter_in_tt = 4\n    wheel_circumference_in = 3.1416 * wheel_diameter_in\n    wheel_circumference_in_tt = 3.1416 * wheel_diameter_in_tt\n\n    # ----------------------------\n    # START INTAKE IMMEDIATELY\n    # ----------------------------\n    ##motor_7.spin(FORWARD, 100, PERCENT)\n    \n   \n    # ----------------------------\n    # HELPER: drive inches\n    # ----------------------------\n    \"\"\"def drive_inches(inches, speed, forward=True):\n        deg = (inches / wheel_circumference_in) * 360\n        direction = FORWARD if forward else REVERSE\n        left_drive.spin_for(direction, deg, DEGREES, speed, PERCENT, False)\n        right_drive.spin_for(direction, deg, DEGREES, speed, PERCENT)\n\n    def drive_inchestt(inches, speed, forward=True):\n        deg = (inches / wheel_circumference_in_tt) * 360\n        direction = FORWARD if forward else REVERSE\n        motor_2.spin_for(direction, deg, DEGREES, speed, PERCENT, False)\n        motor_8.spin_for(direction, deg, DEGREES, speed, PERCENT)    \n\"\"\"\n\n    def drive_inches(inches, speed, forward=True, timeout=10):\n        # Calculate how many degrees the wheels should turn\n        deg = (inches / wheel_circumference_in) * 360\n        direction = FORWARD if forward else REVERSE\n\n        # Reset motor positions\n        left_drive.reset_position()\n        right_drive.reset_position()\n\n        # Start spinning both motors\n        left_drive.spin(direction, speed, PERCENT)\n        right_drive.spin(direction, speed, PERCENT)\n\n        # Start timer\n        timer = Timer()\n        timer.reset()\n\n        # Keep running until either distance reached OR timeout\n        while abs(left_drive.position(DEGREES)) < deg and timer.time(SECONDS) < timeout:\n            wait(10, MSEC)  # small delay to avoid CPU overload\n\n        # Stop both motors\n        left_drive.stop()\n        right_drive.stop()\n    # ----------------------------\n    # HELPER: turn degrees (skid steer)\n    # positive = turn right\n    # ----------------------------\n    def turn_degrees(deg, speed):\n        left_drive.spin_for(FORWARD, deg, DEGREES, speed, PERCENT, False)\n        right_drive.spin_for(REVERSE, deg, DEGREES, speed, PERCENT)\n\n    def turn_to(angle, direction):\n        brain.screen.print(angle, inertial19.heading())\n        if direction == 'right':\n            right_drive.spin(REVERSE, 10, PERCENT)\n            left_drive.spin(FORWARD, 10, PERCENT)\n            while inertial19.heading() > 360 - (angle * 0.8) or  inertial19.heading() < angle:\n                wait(10, MSEC)\n                brain.screen.next_row() \n                brain.screen.print(inertial19.heading())            \n        else: \n            right_drive.spin(FORWARD, 10, PERCENT)\n            left_drive.spin(REVERSE, 10, PERCENT)\n            while inertial19.heading() > angle: \n                wait(10, MSEC)\n                brain.screen.next_row() \n                brain.screen.print(inertial19.heading())\n        right_drive.stop()\n        left_drive.stop()\n    \n    def turn_to_tt(angle, direction):\n        brain.screen.print(angle, inertial19.heading())\n        if direction == 'right':\n            motor_2.spin(REVERSE, 10, PERCENT)\n            motor_8.spin(FORWARD, 10, PERCENT)\n            while inertial19.heading() > 360 - (angle * 0.8) or  inertial19.heading() < angle:\n                wait(10, MSEC)\n                brain.screen.next_row() \n                brain.screen.print(inertial19.heading())            \n        else: \n            motor_2.spin(FORWARD, 10, PERCENT)\n            motor_8.spin(REVERSE, 10, PERCENT)\n            while inertial19.heading() > angle: \n                wait(10, MSEC)\n                brain.screen.next_row() \n                brain.screen.print(inertial19.heading())\n        motor_2.stop()\n        motor_8.stop()\n\n    ##PRE-AUTON\n    def preauton():\n        ##function should callibrate the values for inertia sensor (inertial13.calibrate())\n        ##inertial19.calibrate()\n        ##while inertial19.is_calibrating():\n            ##wait(50, MSEC)\n\n        ##wait(0, MSEC)   # let sensor fully settle\n        inertial19.set_heading(0, DEGREES)\n        ##wait(0, MSEC)  # let it settle\n\n       \n\n\n        ##while True:\n            ##brain.screen.next_row()\n\n            ##brain.screen.print(\"Heading: \" , inertial19.heading())\n           ## wait(200, MSEC)\n\n\n    preauton()\n    #turn_to(90)\n    #turn_to(150)\n    #turn_to(359.9)\n\n    # ----------------------------\n    # AUTON PATH\n    # ----------------------------\n    DRIVE_SPEED = 18\n    DRIVE_SPEED_2 = 36\n    TURN_SPEED = 32\n    #\"\"\"Short Route that works\n    # 1. Forward to collect block 33.12\n    drive_inches(3, DRIVE_SPEED, forward=True)\n    drive_inches(30.12, DRIVE_SPEED_2, forward=True)\n    #2. Turn 80 degrees right\n    turn_to(80, 'right')\n\n    #3. Forward 24 inches\n    drive_inches(19.9, DRIVE_SPEED_2, forward=False, timeout=3)\n    \"\"\"\n    #4. Turn 315 degrees right\n    turn_to(135, 'right')\n\n    #5. Forward 34 inches\n    drive_inches(32, DRIVE_SPEED, forward=True)\n\n    #6. Turn left side motor wheels at 0 degree angle to align with goal\n    turn_to(180, 'right')\n\n    #7. Backward 9 inches\n    drive_inches(9, DRIVE_SPEED, forward=False)\n    \"\"\"\n    \n\n    # SPIN OUTAKE AND INTAKKEEE!!\n    motor_7.spin(FORWARD, 100, PERCENT)\n    wait(1, SECONDS)\n    motor_8.spin(FORWARD, 100, PERCENT)\n    wait(1.5, SECONDS)\n    \n    # 2. Small right turn (~35° robot rotation)\n    #turn_degrees(35 * 2, TURN_SPEED)\n\n    # 3. Reverse segment\n    #drive_inches(18, DRIVE_SPEED, forward=False)\n\n    # 4. Right 90° turn\n   #turn_degrees(90 * 3.5, TURN_SPEED)\n\n    # 5. Reverse long\n    #drive_inches(26, DRIVE_SPEED, forward=False)\n\n    # 6. Right 90° turn again\n    #turn_degrees(90 * 3.5, TURN_SPEED)\n\n    # 7. Reverse final alignment\n    #drive_inches(14, DRIVE_SPEED, forward=False)\n\n    # spin scorer\n    #motor_8.spin(FORWARD, 100, PERCENT)\n    #wait(2, SECONDS)\n    \n    # ----------------------------\n    # STOP EVERYTHING\n    # ----------------------------\n    motor_7.stop()\n    motor_8.stop()\n    left_drive.stop()\n    right_drive.stop()\n\n    brain.screen.new_line()\n    brain.screen.print(\"Autonomous done!\")\n\n# ---------------------------------------------------------\n# Driver control – Arcade (Left joystick only)\n# ---------------------------------------------------------\ndef vexcode_driver_function():\n    global intake_state, L2_pressed_time\n    global claw_state, a_last\n    \n    brain.screen.clear_screen()\n    brain.screen.print(\"Driver control active\")\n\n    while competition.is_driver_control() and competition.is_enabled():\n        # Joystick input\n        forward = controller.axis3.position()\n        turn = controller.axis1.position()\n\n        # Apply separate scaling:\n        forward_speed = forward * MAX_DRIVE_SPEED / 100.0\n        turn_speed = turn * MAX_DRIVE_SPEED * TURN_SCALE / 100.0\n\n        # Combine (arcade drive)\n        left_speed = forward_speed + turn_speed\n        right_speed = forward_speed - turn_speed\n\n        # Clip speeds\n        left_speed = max(min(left_speed, 100), -100)\n        right_speed = max(min(right_speed, 100), -100)\n\n        left_drive.spin(FORWARD, left_speed, PERCENT)\n        right_drive.spin(FORWARD, right_speed, PERCENT)\n\n        # ---- Control scorer (motor_8)\n        if controller.buttonR1.pressing():\n            motor_8.spin(FORWARD, 100, PERCENT) # forward means score\n        elif controller.buttonR2.pressing():\n            motor_8.stop(COAST)\n        \n        ##Pneumatic control button\n        # ---- Pneumatic toggle control ----\n        global matchloader_state, descorer_state, x_last, b_last\n\n        # X → toggle match loader\n        x_now = controller.buttonX.pressing()\n        if x_now and not x_last:          # rising edge = just pressed\n            matchloader_state = not matchloader_state\n            matchloader_a.set(matchloader_state)\n        x_last = x_now\n\n        # B → toggle descorer\n        b_now = controller.buttonB.pressing()\n        if b_now and not b_last:\n            descorer_state = not descorer_state\n            descorer_b.set(descorer_state)\n        b_last = b_now\n\n        # ----------------------------------------\n\n        # A → toggle pneumatic claw\n        a_now = controller.buttonA.pressing()\n\n        if a_now and not a_last:\n            claw_state = not claw_state\n            claw_a.set(claw_state)\n        a_last = a_now\n\n        # Control instake state\n        now = brain.timer.system()  # get current time (seconds)\n        if controller.buttonL1.pressing():\n            intake_state = 1  # start forward\n\n        elif controller.buttonL2.pressing():\n            # Record when L2 first pressed\n            if L2_pressed_time == 0:\n                L2_pressed_time = now\n            # If held long enough -> reverse\n            elif now - L2_pressed_time > 0.3:\n                intake_state = 2\n\n        else:\n            # L2 released\n            if L2_pressed_time != 0:\n                # Was a quick tap? -> stop\n                if now - L2_pressed_time <= 0.3:\n                    intake_state = 0\n                L2_pressed_time = 0  # reset timer\n            elif intake_state == 2:\n                # released after reversing -> stop\n                intake_state = 0\n\n        # Control Motor 7 (intake motor)\n        if intake_state == 1:\n            motor_7.spin(FORWARD, 100, PERCENT) # forward means block up\n        elif intake_state == 2:\n            motor_7.spin(REVERSE, 100, PERCENT) # reverse means block down\n        else:\n            motor_7.stop(COAST)\n\n        # Control Motor 7 (intake motor)\n        if controller.buttonUp.pressing():\n            motor_18.spin(FORWARD, 60, PERCENT) \n        elif controller.buttonDown.pressing():\n            motor_18.spin(REVERSE, 60, PERCENT) \n        else:\n            motor_18.stop(COAST)\n\n        wait(20, MSEC)\n        \n##\n##Testing Auton at home\n##vexcode_auton_function() # Comment out this line on the competition day!\n\n# ---------------------------------------------------------\n# Register competition functions\n# ---------------------------------------------------------\ncompetition = Competition(vexcode_driver_function, vexcode_auton_function)\n\n# ---------------------------------------------------------\n# Keep program alive forever\n# ---------------------------------------------------------\nwhile True:\n    wait(100, MSEC)\n","textLanguage":"python","robotConfig":[{"port":[6],"name":"motor_6","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1"},"triportSourcePort":22},{"port":[8],"name":"motor_8","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1"},"triportSourcePort":22},{"port":[19],"name":"inertial_","customName":true,"deviceType":"Inertial","deviceClass":"inertial","setting":{},"triportSourcePort":22},{"port":[1],"name":"matchloader_a","customName":true,"deviceType":"DigitalOut","deviceClass":"digital_out","setting":{},"triportSourcePort":22},{"port":[2],"name":"descorer_b","customName":true,"deviceType":"DigitalOut","deviceClass":"digital_out","setting":{},"triportSourcePort":22},{"port":[2],"name":"motor_2","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1"},"triportSourcePort":22},{"port":[7],"name":"motor_7","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1"},"triportSourcePort":22},{"port":[18],"name":"motor_18","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1"},"triportSourcePort":22}],"slot":0,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.68.0","minVersion":"4.60.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null},"target":"Physical"}